{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "functions": {
    "api/index.py": {
      "includeFiles": "{web,src,data}/**",
      "excludeFiles": "{tests/**,docs/**,specs/**,tasks/**,scripts/**,context/**,Chat*/**,_uv/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py?__path=/api/$1"
    },
    {
      "source": "/",
      "destination": "/web/index.html"
    },
    {
      "source": "/index.html",
      "destination": "/web/index.html"
    },
    {
      "source": "/entidades",
      "destination": "/web/entidades.html"
    },
    {
      "source": "/entidad",
      "destination": "/web/entidad-detalle.html"
    },
    {
      "source": "/alertas",
      "destination": "/web/alertas.html"
    },
    {
      "source": "/contrataciones",
      "destination": "/web/contrataciones.html"
    },
    {
      "source": "/contrato",
      "destination": "/web/contrato-detalle.html"
    },
    {
      "source": "/presupuesto",
      "destination": "/web/presupuesto.html"
    },
    {
      "source": "/proveedores",
      "destination": "/web/proveedores.html"
    },
    {
      "source": "/concentracion",
      "destination": "/web/proveedores.html"
    },
    {
      "source": "/denuncia",
      "destination": "/web/denuncia.html"
    },
    {
      "source": "/transparencia",
      "destination": "/web/transparencia.html"
    },
    {
      "source": "/acerca",
      "destination": "/web/acerca.html"
    },
    {
      "source": "/metodologia",
      "destination": "/web/metodologia.html"
    },
    {
      "source": "/georreferenciacion",
      "destination": "/web/georreferenciacion.html"
    },
    {
      "source": "/mapa",
      "destination": "/web/georreferenciacion.html"
    },
    {
      "source": "/admin",
      "destination": "/web/admin-revision.html"
    },
    {
      "source": "/admin/revision",
      "destination": "/web/admin-revision.html"
    },
    {
      "source": "/login",
      "destination": "/web/login.html"
    },
    {
      "source": "/acreditacion",
      "destination": "/web/login.html"
    },
    {
      "source": "/([a-z-]+).html",
      "destination": "/web/$1.html"
    },
    {
      "source": "/DESIGN.md",
      "destination": "/web/DESIGN.md"
    },
    {
      "source": "/src/(.*)",
      "destination": "/web/src/$1"
    },
    {
      "source": "/media/(.*)",
      "destination": "/web/media/$1"
    },
    {
      "source": "/css/(.*)",
      "destination": "/web/css/$1"
    },
    {
      "source": "/fonts/(.*)",
      "destination": "/web/fonts/$1"
    },
    {
      "source": "/favicon.ico",
      "destination": "/web/favicon.ico"
    },
    {
      "source": "/favicon.svg",
      "destination": "/web/favicon.svg"
    },
    {
      "source": "/apple-touch-icon.png",
      "destination": "/web/apple-touch-icon.png"
    },
    {
      "source": "/icon-192.png",
      "destination": "/web/icon-192.png"
    },
    {
      "source": "/icon-512.png",
      "destination": "/web/icon-512.png"
    },
    {
      "source": "/icon-maskable-512.png",
      "destination": "/web/icon-maskable-512.png"
    },
    {
      "source": "/safari-pinned-tab.svg",
      "destination": "/web/safari-pinned-tab.svg"
    },
    {
      "source": "/site.webmanifest",
      "destination": "/web/site.webmanifest"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
